{
  "name": "ims-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm run build --prefix web",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ims --local",
    "db:migrate:remote": "wrangler d1 migrations apply ims --remote",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
